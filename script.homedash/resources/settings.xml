<?xml version="1.0" encoding="utf-8"?>
<settings version="1">
  <section id="script.homedash">
    <category id="general" label="Feeds">
      <group id="1">
        <setting id="feeds" type="string" label="Feed URLs (comma or newline separated)">
          <level>0</level>
          <default>https://retrogamecoders.com/feed/</default>
          <control type="edit" format="string">
            <heading>Feed URLs</heading>
          </control>
        </setting>
      </group>
    </category>
    <category id="startup" label="Startup">
      <group id="1">
        <setting id="autostart" type="boolean" label="Open dashboard at Kodi startup">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
    <category id="bins" label="Bins">
      <group id="1">
        <!-- Per-device only. Point at a pre-scrubbed bin-days JSON you host.
             Never commit this value; it stays in this box's addon_data. -->
        <setting id="bin_url" type="string" label="Bin days JSON URL">
          <level>0</level>
          <default></default>
          <control type="edit" format="string">
            <heading>Bin days JSON URL</heading>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
